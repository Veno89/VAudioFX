{
  "name": "vaudiofx",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "test": "vitest run",
    "test:e2e": "node scripts/run-e2e.mjs",
    "check:assets": "node scripts/check-assets.mjs && node scripts/check-third-party.mjs && node scripts/check-runtime-licenses.mjs",
    "check:release": "node scripts/check-release.mjs",
    "package:preview": "node scripts/package-release.mjs",
    "quality:gate": "npm run check:assets && npm test && npm run build && npm run check:release && npm run test:e2e && node scripts/run-e2e.mjs --production tests/e2e/offline.spec.ts && node scripts/record-qualification.mjs"
  },
  "dependencies": {
    "@soundtouchjs/core": "2.1.1",
    "fflate": "0.8.3",
    "lucide-react": "^0.468.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "wasm-media-encoders": "0.7.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "6.1.2",
    "fake-indexeddb": "^6.2.4",
    "typescript": "^5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3"
  }
}
